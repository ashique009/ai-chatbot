# Django Configuration
DEBUG=True
SECRET_KEY=django-insecure-replace-with-a-secure-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_NAME=chatpartner_db
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Configuration (allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=False

# AI Provider Configuration ('gemini' or 'openai')
AI_PROVIDER=gemini

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Delivery Channel Configuration
IN_APP_MESSAGING_ENABLED=True
PUSH_NOTIFICATIONS_ENABLED=False

# Push Notification Provider Credentials (optional, required if push delivery is enabled)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=
FCM_SERVER_KEY=

# Meta / Instagram Messaging API Configuration
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=your_meta_webhook_verify_token_here
INSTAGRAM_API_VERSION=v20.0
