# Backend API base URL
# Local development:
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Production on Vercel:
# Option A (Recommended - same-origin via Vercel reverse proxy rewrite in vercel.json):
# VITE_API_BASE_URL=/api
#
# Option B (Direct cross-site call to Render backend):
# VITE_API_BASE_URL=https://ami-bot-9ys2.onrender.com/api
